# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ticket_triage

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- LLM providers (all free-tier, no card required) ---
LLM_PROVIDER=groq              # groq | gemini | cerebras | cloudflare | ollama
GROQ_API_KEY=                  # https://console.groq.com
GEMINI_API_KEY=                # https://aistudio.google.com
CEREBRAS_API_KEY=              # https://cloud.cerebras.ai/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=          # https://dash.cloudflare.com/
OLLAMA_BASE_URL=http://ollama:11434

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Observability (optional, self-hosted Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# --- App ---
CONFIDENCE_THRESHOLD=0.7
ENVIRONMENT=development
